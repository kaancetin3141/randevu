# GNC Randevu — ortam değişkenleri örneği
# Kopyala: cp .env.example .env  (Bun .env dosyasını otomatik yükler)

# GNC ERP (CRM) API taban adresi — randevu servisi TÜM verilerini buradan
# server-side fetch ile çeker (kendi veritabanı yoktur).
# Geliştirme (ERP lokalinizde 3001 portundayken):
CRM_BASE_URL=http://localhost:3001
# Üretim örneği:
# CRM_BASE_URL=https://crm.gncinc.online

# Alt alan adı modu: {slug}.BASE_DOMAIN Host başlığıyle açılan istekler o
# işletmenin vitrin sayfasına yönlendirilir. Ana liste randevu.BASE_DOMAIN
# üzerinden servis edilir. Boş bırakılırsa alt alan adı desteği kapanır
# (her şey tek host altında göreli URL'lerle çalışır).
BASE_DOMAIN=gncinc.online
